# Copiar a .env y ajustar. Nunca commitear .env.

# --- Obligatorio ---
# Cifra datos sensibles en la base de datos (API keys). Generar con: openssl rand -base64 32
# Si cambia, las API keys guardadas dejan de poder leerse y hay que volver a ingresarlas.
APP_SECRET=

# --- IA (ver ADR 0006) ---
# Token de la suscripción de Claude para el proveedor "línea de comandos" en Docker.
# Se genera con `claude setup-token`. En desarrollo local no hace falta: usa la sesión de `claude`.
# CLAUDE_CODE_OAUTH_TOKEN=
# LLM_MODEL=claude-opus-5-5
# Profundidad de razonamiento: low | medium | high | xhigh | max
# LLM_EFFORT=medium
# LLM_TIMEOUT_MS=180000

# --- docker compose ---
# Interfaz y puerto donde se publica la web. Dejar en 127.0.0.1: el reverse proxy HTTPS del
# servidor reenvía el tráfico aquí y es la única entrada desde internet (ver ADR 0010).
BIND_ADDRESS=127.0.0.1
WEB_PORT=8080

# --- API (desarrollo local; en docker compose DATABASE_PATH lo fija el compose) ---
# PORT=3000
# DATABASE_PATH=data/job-finder.sqlite
# UPLOADS_DIR=data/uploads
# Capturas y HTML que guarda una búsqueda cuando falla.
# ARTIFACTS_DIR=data/artifacts
# Tope de ofertas que lee una búsqueda en un portal, y de páginas de detalle que abre.
# SEARCH_MAX_LISTINGS=100
# SEARCH_MAX_DETAILS=30
# Pausa mínima entre páginas de un portal, en milisegundos (la real varía hasta el triple).
# PORTAL_PAUSE_MS=1000
# Puerto del portal de demostración que se levanta junto con la API (0 no lo levanta).
# DEMO_PORTAL_PORT=4100
# SESSION_TTL_DAYS=30
# Cookie de sesión solo por HTTPS. Por defecto true con NODE_ENV=production (docker compose)
# y false en desarrollo. Desactivar solo si se sirve en producción sin HTTPS.
# SESSION_COOKIE_SECURE=
