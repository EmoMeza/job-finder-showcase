{
  "name": "@job-finder/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "build": "nest build",
    "dev": "tsc -p tsconfig.build.json && pnpm run \"/^dev:/\"",
    "dev:build": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "dev:serve": "node --watch --watch-preserve-output --enable-source-maps dist/main.js",
    "start": "node dist/main.js",
    "cli": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.0",
    "@job-finder/shared": "workspace:*",
    "@job-finder/sources": "workspace:*",
    "@nestjs/common": "^12.1.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "@node-rs/argon2": "^2.2.2",
    "better-sqlite3": "^13.0.3",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.4",
    "helmet": "^8.3.0",
    "playwright": "^1.64.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.1.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.3.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
